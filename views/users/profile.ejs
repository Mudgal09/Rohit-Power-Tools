<%- layout('layouts/boilerplate') %>
<div class="container py-4">
  <h2 class="section-title mb-4">My <span class="text-orange">Profile</span></h2>
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="checkout-card text-center">
        <div class="profile-avatar mx-auto mb-3"><%= currentUser.username.charAt(0).toUpperCase() %></div>
        <h5><%= currentUser.fullName || currentUser.username %></h5>
        <div class="text-muted small"><%= currentUser.email %></div>
        <div class="mt-3 d-flex flex-column gap-2">
          <a href="/orders" class="btn btn-outline-orange btn-sm"><i class="bi bi-box-seam me-1"></i>My Orders</a>
          <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
        </div>
      </div>
    </div>
    <div class="col-lg-8">
      <div class="checkout-card">
        <h5 class="fw-bold mb-3">Update Profile</h5>
        <form action="/profile/update" method="POST">
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control rpt-input" name="fullName" value="<%= currentUser.fullName || '' %>">
            </div>
            <div class="col-sm-6">
              <label class="form-label">Phone</label>
              <input type="tel" class="form-control rpt-input" name="phone" value="<%= currentUser.phone || '' %>">
            </div>
            <div class="col-12">
              <label class="form-label">Address</label>
              <input type="text" class="form-control rpt-input" name="line1" placeholder="Street address" value="<%= currentUser.address && currentUser.address.line1 || '' %>">
            </div>
            <div class="col-sm-4">
              <input type="text" class="form-control rpt-input" name="city" placeholder="City" value="<%= currentUser.address && currentUser.address.city || '' %>">
            </div>
            <div class="col-sm-4">
              <input type="text" class="form-control rpt-input" name="state" placeholder="State" value="<%= currentUser.address && currentUser.address.state || '' %>">
            </div>
            <div class="col-sm-4">
              <input type="text" class="form-control rpt-input" name="pincode" placeholder="Pincode" value="<%= currentUser.address && currentUser.address.pincode || '' %>">
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-orange">Save Changes</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
