<%- layout('layouts/boilerplate') %>

<div class="container py-4">
  <h2 class="section-title mb-1">Bolt <span class="text-orange">AI</span> — Customer Support</h2>
  <p class="text-muted small mb-4">Your 24/7 power tool expert. Ask about products, orders, warranties & more.</p>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="chat-container">
        <div class="chat-header">
          <div class="chat-avatar-wrap">🤖</div>
          <div class="flex-fill">
            <div class="chat-name">Bolt AI — Support Assistant</div>
            <div class="chat-status"><span class="status-dot"></span>Online · Ready to help</div>
          </div>
          <div class="text-end">
            <div class="text-orange small fw-bold" style="font-family:monospace">ROHIT POWER TOOLS</div>
            <div class="text-muted" style="font-size:11px">Powered by Gemini AI</div>
          </div>
        </div>

        <div class="chat-messages" id="chatMessages"></div>

        <div class="chat-quick-replies" id="quickReplies">
          <button class="quick-reply" data-msg="Track my order">📦 Track Order</button>
          <button class="quick-reply" data-msg="What is your return policy?">🔄 Returns</button>
          <button class="quick-reply" data-msg="Warranty information">🛡️ Warranty</button>
          <button class="quick-reply" data-msg="Best drill for home use under 5000 rupees">🔩 Best Drill</button>
          <button class="quick-reply" data-msg="Shipping details and delivery time">🚚 Shipping</button>
          <button class="quick-reply" data-msg="Compare Bosch vs DeWalt drills">⚖️ Compare Brands</button>
          <button class="quick-reply" data-msg="What coupon codes are available?">🏷️ Coupons</button>
          <button class="quick-reply" data-msg="Recommend best products">⭐ Recommend</button>
        </div>

        <div class="chat-input-row">
          <input class="chat-input" type="text" id="chatInput"
            placeholder="Ask about products, orders, warranties...">
          <button class="chat-send-btn" id="chatSendBtn" title="Send">➤</button>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-3 text-orange"><i class="bi bi-robot me-2"></i>What Bolt AI Can Do</h6>
        <div class="d-flex flex-column gap-2">
          <div class="chat-capability"><span>🔧</span><div><strong>Product Help</strong><br><small class="text-muted">Find the right tool for your job</small></div></div>
          <div class="chat-capability"><span>📦</span><div><strong>Order Tracking</strong><br><small class="text-muted">Check status with your order number</small></div></div>
          <div class="chat-capability"><span>🔄</span><div><strong>Returns & Refunds</strong><br><small class="text-muted">Understand our 30-day policy</small></div></div>
          <div class="chat-capability"><span>🛡️</span><div><strong>Warranty Claims</strong><br><small class="text-muted">Get warranty support info</small></div></div>
          <div class="chat-capability"><span>⚖️</span><div><strong>Brand Comparisons</strong><br><small class="text-muted">Bosch vs DeWalt vs Makita</small></div></div>
          <div class="chat-capability"><span>💰</span><div><strong>Deals & Coupons</strong><br><small class="text-muted">Ask about discount codes</small></div></div>
        </div>
      </div>
      <div class="checkout-card">
        <h6 class="fw-bold mb-3"><i class="bi bi-telephone-fill text-orange me-1"></i>Still Need Help?</h6>
        <div class="d-flex flex-column gap-2 text-muted small">
          <div><i class="bi bi-telephone me-2 text-orange"></i>1800-ROHIT-TOOLS</div>
          <div><i class="bi bi-envelope me-2 text-orange"></i>support@rohitpowertools.in</div>
          <div><i class="bi bi-clock me-2 text-orange"></i>Mon-Sat, 9am-6pm IST</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.chat-container { background: var(--iron); border: 1px solid var(--zinc); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; height: 620px; }
.chat-header { background: var(--steel); border-bottom: 2px solid var(--orange); padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; }
.chat-avatar-wrap { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--orange), var(--yellow)); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; }
.chat-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1.1rem; }
.chat-status { font-size: 11px; color: var(--green); display: flex; align-items: center; gap: 5px; font-family: monospace; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
.chat-messages { flex: 1; overflow-y: auto; padding: 1.2rem; display: flex; flex-direction: column; gap: .8rem; scroll-behavior: smooth; }
.chat-messages::-webkit-scrollbar { width: 4px; }
.chat-messages::-webkit-scrollbar-track { background: var(--steel); }
.chat-messages::-webkit-scrollbar-thumb { background: var(--zinc); border-radius: 2px; }
.msg { display: flex; gap: 8px; max-width: 82%; }
.msg.user { align-self: flex-end; flex-direction: row-reverse; }
.msg-avatar { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
.msg.bot  .msg-avatar { background: linear-gradient(135deg, var(--orange), var(--yellow)); }
.msg.user .msg-avatar { background: var(--zinc); }
.msg-bubble { padding: .7rem 1rem; border-radius: 12px; font-size: .875rem; line-height: 1.6; }
.msg.bot  .msg-bubble { background: var(--steel); border: 1px solid var(--zinc); border-radius: 0 12px 12px 12px; }
.msg.user .msg-bubble { background: var(--orange); color: #fff; border-radius: 12px 0 12px 12px; }
.msg-time { font-size: 10px; color: var(--smoke); margin-top: 3px; font-family: monospace; }
.msg.user .msg-time { text-align: right; }
.typing-indicator { display: flex; align-items: center; gap: 4px; padding: .4rem; }
.typing-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); animation: typingBounce 1.2s ease-in-out infinite; }
.typing-dot:nth-child(2) { animation-delay: .2s; }
.typing-dot:nth-child(3) { animation-delay: .4s; }
@keyframes typingBounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-8px)} }
.chat-quick-replies { padding: .7rem 1.2rem; border-top: 1px solid var(--zinc); display: flex; gap: .4rem; flex-wrap: wrap; }
.quick-reply { padding: .3rem .7rem; border: 1px solid var(--zinc); border-radius: 20px; font-size: .75rem; color: var(--silver); cursor: pointer; background: var(--steel); white-space: nowrap; transition: all .2s; font-family: inherit; }
.quick-reply:hover { border-color: var(--orange); color: var(--orange); background: rgba(249,115,22,.1); }
.chat-input-row { padding: .8rem 1.2rem; border-top: 1px solid var(--zinc); display: flex; gap: .6rem; background: var(--steel); }
.chat-input { flex: 1; background: var(--iron); border: 1px solid var(--zinc); color: var(--light); padding: .6rem 1rem; border-radius: 24px; font-family: 'Barlow', sans-serif; font-size: .875rem; outline: none; transition: border-color .2s; }
.chat-input:focus { border-color: var(--orange); }
.chat-input::placeholder { color: var(--smoke); }
.chat-send-btn { width: 42px; height: 42px; border-radius: 50%; background: var(--orange); color: #fff; font-size: 1rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .2s; flex-shrink: 0; border: none; font-family: inherit; }
.chat-send-btn:hover { background: var(--orange2); transform: scale(1.05); }
.chat-capability { display: flex; gap: .8rem; align-items: flex-start; font-size: .875rem; }
.chat-capability span { font-size: 1.2rem; flex-shrink: 0; }
</style>

<script>
(function() {
  var chatHistory = [];
  var username    = '<%= currentUser ? currentUser.username : "" %>';

  function getTime() {
    return new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
  }

  function appendMsg(role, text, time) {
    var msgs = document.getElementById('chatMessages');
    var div  = document.createElement('div');
    div.className = 'msg ' + role;
    var formatted = text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>');
    div.innerHTML =
      '<div class="msg-avatar">' + (role === 'bot' ? '🤖' : '👤') + '</div>' +
      '<div>' +
        '<div class="msg-bubble">' + formatted + '</div>' +
        '<div class="msg-time">' + time + '</div>' +
      '</div>';
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }

  function showTyping() {
    var msgs = document.getElementById('chatMessages');
    var div  = document.createElement('div');
    div.className = 'msg bot';
    div.id = 'typingIndicator';
    div.innerHTML =
      '<div class="msg-avatar">🤖</div>' +
      '<div><div class="msg-bubble" style="padding:.6rem">' +
        '<div class="typing-indicator">' +
          '<div class="typing-dot"></div>' +
          '<div class="typing-dot"></div>' +
          '<div class="typing-dot"></div>' +
        '</div>' +
      '</div></div>';
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }

  function sendChat() {
    var inp  = document.getElementById('chatInput');
    var btn  = document.getElementById('chatSendBtn');
    var text = inp.value.trim();
    if (!text) return;

    inp.value    = '';
    inp.disabled = true;
    btn.disabled = true;

    appendMsg('user', text, getTime());
    chatHistory.push({ role: 'user', content: text });

    var typingEl = showTyping();

    fetch('/api/chat', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ messages: chatHistory })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (typingEl) typingEl.remove();
      var reply = (data && data.reply) ? data.reply : 'Sorry, I could not process that. Please try again.';
      chatHistory.push({ role: 'assistant', content: reply });
      appendMsg('bot', reply, getTime());
    })
    .catch(function(err) {
      if (typingEl) typingEl.remove();
      appendMsg('bot', 'Sorry, something went wrong. Please try again!', getTime());
    })
    .finally(function() {
      inp.disabled = false;
      btn.disabled = false;
      inp.focus();
    });
  }

  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {

    // Welcome message
    var greeting = username
      ? 'Hello, <strong>' + username + '</strong>! I am <strong>Bolt</strong>, your Rohit Power Tools AI assistant.'
      : 'Hello! I am <strong>Bolt</strong>, your Rohit Power Tools AI assistant.';
    appendMsg('bot',
      greeting + '\n\nI can help you with:\n• Product recommendations\n• Order tracking (share your order number)\n• Returns and warranty info\n• Brand comparisons and pricing\n\nWhat can I help you with today?',
      getTime()
    );

    // Send button click
    document.getElementById('chatSendBtn').addEventListener('click', function() {
      sendChat();
    });

    // Enter key to send
    document.getElementById('chatInput').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendChat();
      }
    });

    // Quick reply buttons
    document.querySelectorAll('.quick-reply').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var msg = btn.getAttribute('data-msg');
        document.getElementById('chatInput').value = msg;
        sendChat();
      });
    });

  });

})();
</script>
