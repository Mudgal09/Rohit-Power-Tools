<%- layout('layouts/boilerplate') %>
<div class="container py-4">
  <h2 class="section-title mb-4">My <span class="text-orange">Orders</span></h2>
  <% if (!orders.length) { %>
    <div class="text-center py-5">
      <div style="font-size:4rem">📦</div>
      <h4 class="text-muted mt-3">No orders yet!</h4>
      <a href="/products" class="btn btn-orange mt-3">Start Shopping</a>
    </div>
  <% } else { %>
    <% orders.forEach(order => { %>
      <div class="order-card mb-3">
        <div class="order-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <span class="fw-bold text-orange">#<%= order.orderNumber %></span>
            <span class="text-muted small ms-3"><%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
          </div>
          <div class="d-flex gap-2 align-items-center">
            <span class="badge order-status-badge status-<%= order.status %>"><%= order.status.toUpperCase() %></span>
            <span class="fw-bold text-orange">₹<%= order.pricing.total.toLocaleString() %></span>
            <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-orange">View Details</a>
          </div>
        </div>
        <div class="order-card-body d-flex gap-3 flex-wrap">
          <% order.items.slice(0,3).forEach(item => { %>
            <div class="d-flex gap-2 align-items-center">
              <img src="<%= item.image %>" alt="" style="width:48px;height:36px;object-fit:cover;border-radius:4px;border:1px solid #333">
              <span class="small text-muted"><%= item.name.substring(0,30) %><% if(item.name.length>30){%>...<% } %></span>
            </div>
          <% }) %>
          <% if (order.items.length > 3) { %>
            <span class="text-muted small align-self-center">+<%= order.items.length - 3 %> more</span>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
