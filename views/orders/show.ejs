<%- layout('layouts/boilerplate') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="section-title mb-0">Order <span class="text-orange">#<%= order.orderNumber %></span></h2>
    <div class="d-flex gap-2">
      <span class="badge order-status-badge status-<%= order.status %> fs-6"><%= order.status.toUpperCase() %></span>
      <% if (['placed','confirmed'].includes(order.status)) { %>
        <form action="/orders/<%= order._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this order?')">
          <button class="btn btn-sm btn-outline-danger">Cancel Order</button>
        </form>
      <% } %>
      <a href="/orders" class="btn btn-sm btn-outline-secondary">← My Orders</a>
    </div>
  </div>

  <div class="row g-4">
    <!-- LEFT: Items + Tracking -->
    <div class="col-lg-8">
      <!-- ITEMS -->
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-3"><i class="bi bi-box-seam text-orange me-2"></i>Items Ordered</h6>
        <% order.items.forEach(item => { %>
          <div class="d-flex gap-3 mb-3 pb-3 border-bottom border-secondary align-items-center">
            <img src="<%= item.image %>" alt="" style="width:72px;height:54px;object-fit:cover;border-radius:6px;border:1px solid #333">
            <div class="flex-fill">
              <div class="fw-bold"><%= item.name %></div>
              <div class="text-muted small"><%= item.brand %> · Qty: <%= item.qty %></div>
            </div>
            <div class="text-orange fw-bold">₹<%= (item.price * item.qty).toLocaleString() %></div>
          </div>
        <% }) %>
      </div>

      <!-- TRACKING TIMELINE -->
      <div class="checkout-card">
        <h6 class="fw-bold mb-3"><i class="bi bi-truck text-orange me-2"></i>Order Tracking</h6>
        <div class="tracking-timeline">
          <% const allStatuses = ['placed','confirmed','processing','shipped','delivered']; %>
          <% const currentIdx = allStatuses.indexOf(order.status); %>
          <% allStatuses.forEach((s, idx) => { %>
            <div class="tracking-step <%= idx <= currentIdx ? 'done' : '' %> <%= s === order.status ? 'current' : '' %>">
              <div class="tracking-dot"></div>
              <div class="tracking-info">
                <div class="fw-bold text-capitalize"><%= s %></div>
                <% const entry = order.tracking.find(t => t.status === s); %>
                <% if (entry) { %>
                  <div class="text-muted small"><%= entry.message %> · <%= new Date(entry.date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <% if (order.estimatedDelivery && !['delivered','cancelled'].includes(order.status)) { %>
          <div class="alert alert-info mt-3 small p-2">
            <i class="bi bi-calendar-check me-1"></i>
            Estimated delivery: <strong><%= new Date(order.estimatedDelivery).toLocaleDateString('en-IN',{weekday:'long',day:'2-digit',month:'long'}) %></strong>
          </div>
        <% } %>
      </div>
    </div>

    <!-- RIGHT: Summary + Address -->
    <div class="col-lg-4">
      <div class="cart-summary-box mb-3">
        <h6 class="fw-bold mb-3">Payment Summary</h6>
        <div class="summary-row"><span>Subtotal</span><span>₹<%= order.pricing.subtotal.toLocaleString() %></span></div>
        <% if (order.pricing.discount > 0) { %>
          <div class="summary-row text-success"><span>Discount</span><span>-₹<%= order.pricing.discount.toLocaleString() %></span></div>
        <% } %>
        <div class="summary-row"><span>Shipping</span><span><%= order.pricing.shipping === 0 ? '<span class="text-success">FREE</span>' : '₹' + order.pricing.shipping %></span></div>
        <div class="summary-row"><span>GST</span><span>₹<%= order.pricing.gst.toLocaleString() %></span></div>
        <div class="summary-row total-row"><span>Total Paid</span><span class="text-orange">₹<%= order.pricing.total.toLocaleString() %></span></div>
        <hr class="border-secondary">
        <div class="small text-muted">
          <div><strong>Payment:</strong> <%= order.payment.method === 'razorpay' ? 'Online (Razorpay)' : 'Cash on Delivery' %></div>
          <div><strong>Status:</strong> <span class="<%= order.payment.status === 'paid' ? 'text-success' : 'text-warning' %>"><%= order.payment.status.toUpperCase() %></span></div>
          <% if (order.payment.razorpayPaymentId) { %>
            <div class="text-muted"><strong>Txn ID:</strong> <%= order.payment.razorpayPaymentId %></div>
          <% } %>
        </div>
      </div>
      <div class="checkout-card">
        <h6 class="fw-bold mb-2"><i class="bi bi-geo-alt-fill text-orange me-1"></i>Delivery Address</h6>
        <div class="small text-muted">
          <div class="fw-bold text-light"><%= order.shippingAddress.fullName %></div>
          <div><%= order.shippingAddress.line1 %></div>
          <div><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> – <%= order.shippingAddress.pincode %></div>
          <div>📞 <%= order.shippingAddress.phone %></div>
        </div>
      </div>
    </div>
  </div>
</div>
