<%- layout('layouts/boilerplate') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">⚡ Admin <span class="text-orange">Dashboard</span></h2>
    <a href="/admin/products/new" class="btn btn-orange"><i class="bi bi-plus-lg me-1"></i>Add Product</a>
  </div>

  <!-- STATS -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="stat-icon">📦</div>
        <div class="stat-val"><%= totalProducts %></div>
        <div class="stat-label">Products</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="stat-icon">🛒</div>
        <div class="stat-val"><%= totalOrders %></div>
        <div class="stat-label">Total Orders</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-val"><%= totalUsers %></div>
        <div class="stat-label">Customers</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card highlight">
        <div class="stat-icon">💰</div>
        <div class="stat-val text-orange">₹<%= totalRevenue.toLocaleString() %></div>
        <div class="stat-label">Total Revenue</div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- RECENT ORDERS -->
    <div class="col-lg-8">
      <div class="admin-card">
        <div class="d-flex justify-content-between mb-3">
          <h5 class="fw-bold mb-0">Recent Orders</h5>
          <a href="/admin/orders" class="btn btn-sm btn-outline-orange">View All</a>
        </div>
        <div class="table-responsive">
          <table class="table rpt-table">
            <thead><tr><th>Order #</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr></thead>
            <tbody>
              <% recentOrders.forEach(order => { %>
                <tr>
                  <td class="text-orange fw-bold">#<%= order.orderNumber %></td>
                  <td><%= (order.user && order.user.username) || 'N/A' %></td>
                  <td>₹<%= order.pricing.total.toLocaleString() %></td>
                  <td><span class="badge order-status-badge status-<%= order.status %>"><%= order.status %></span></td>
                  <td><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
                  <td><a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <!-- LOW STOCK -->
    <div class="col-lg-4">
      <div class="admin-card">
        <h5 class="fw-bold mb-3">⚠️ Low Stock</h5>
        <% if (lowStock.length) { %>
          <% lowStock.forEach(p => { %>
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary">
              <div>
                <div class="small fw-bold"><%= p.name.substring(0,25) %>...</div>
                <div class="small text-muted"><%= p.brand %></div>
              </div>
              <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-warning text-dark"><%= p.stock %> left</span>
                <a href="/admin/products/<%= p._id %>/edit" class="btn btn-sm btn-outline-orange">Edit</a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-muted small">✅ All products well-stocked</p>
        <% } %>
      </div>
      <div class="admin-card mt-3">
        <h5 class="fw-bold mb-3">Quick Actions</h5>
        <div class="d-flex flex-column gap-2">
          <a href="/admin/products/new" class="btn btn-orange btn-sm"><i class="bi bi-plus me-1"></i>Add Product</a>
          <a href="/admin/products"     class="btn btn-outline-orange btn-sm"><i class="bi bi-grid me-1"></i>Manage Products</a>
          <a href="/admin/orders"       class="btn btn-outline-orange btn-sm"><i class="bi bi-box-seam me-1"></i>Manage Orders</a>
          <a href="/admin/users"        class="btn btn-outline-orange btn-sm"><i class="bi bi-people me-1"></i>Manage Users</a>
        </div>
      </div>
    </div>
  </div>
</div>
