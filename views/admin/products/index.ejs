<%- layout('layouts/boilerplate') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">Manage <span class="text-orange">Products</span></h2>
    <div class="d-flex gap-2">
      <a href="/admin" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
      <a href="/admin/products/new" class="btn btn-orange btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Product</a>
    </div>
  </div>
  <div class="admin-card">
    <div class="table-responsive">
      <table class="table rpt-table align-middle">
        <thead>
          <tr><th>Image</th><th>Name</th><th>Brand</th><th>Category</th><th>Price</th><th>Stock</th><th>Featured</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr>
              <td><img src="<%= p.primaryImage %>" alt="" style="width:60px;height:45px;object-fit:cover;border-radius:4px;border:1px solid #333"></td>
              <td class="fw-bold" style="max-width:200px"><%= p.name %></td>
              <td><span class="badge bg-secondary"><%= p.brand %></span></td>
              <td><%= p.category %></td>
              <td>
                <div class="text-orange fw-bold">₹<%= p.price.toLocaleString() %></div>
                <div class="text-muted text-decoration-line-through small">₹<%= p.mrp.toLocaleString() %></div>
              </td>
              <td><span class="badge <%= p.stock > 5 ? 'bg-success' : p.stock > 0 ? 'bg-warning text-dark' : 'bg-danger' %>"><%= p.stock %></span></td>
              <td><%= p.isFeatured ? '⭐' : '—' %></td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/products/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                  <a href="/admin/products/<%= p._id %>/edit" class="btn btn-sm btn-outline-orange" title="Edit"><i class="bi bi-pencil"></i></a>
                  <form action="/admin/products/<%= p._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this product?')">
                    <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
