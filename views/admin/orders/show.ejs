<%- layout('layouts/boilerplate') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">Order <span class="text-orange">#<%= order.orderNumber %></span></h2>
    <a href="/admin/orders" class="btn btn-outline-secondary btn-sm">← All Orders</a>
  </div>
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-3">Update Order Status</h6>
        <form action="/admin/orders/<%= order._id %>/status?_method=PUT" method="POST" class="d-flex gap-2 flex-wrap">
          <select class="form-select rpt-input w-auto" name="status">
            <% ['placed','confirmed','processing','shipped','delivered','cancelled','returned'].forEach(s => { %>
              <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-orange">Update Status</button>
        </form>
      </div>
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-3">Items</h6>
        <% order.items.forEach(item => { %>
          <div class="d-flex gap-3 align-items-center mb-3 pb-3 border-bottom border-secondary">
            <img src="<%= item.image %>" alt="" style="width:64px;height:48px;object-fit:cover;border-radius:4px;border:1px solid #333">
            <div class="flex-fill"><div class="fw-bold"><%= item.name %></div><div class="text-muted small"><%= item.brand %> · Qty: <%= item.qty %></div></div>
            <div class="text-orange fw-bold">₹<%= (item.price * item.qty).toLocaleString() %></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-2">Customer</h6>
        <div class="small"><div><strong><%= (order.user && order.user.username) %></strong></div><div class="text-muted"><%= (order.user && order.user.email) %></div><div class="text-muted"><%= (order.user && order.user.phone) || (order.shippingAddress && order.shippingAddress.phone) %></div></div>
      </div>
      <div class="checkout-card mb-3">
        <h6 class="fw-bold mb-2">Shipping Address</h6>
        <div class="small text-muted">
          <div class="fw-bold text-light"><%= order.shippingAddress.fullName %></div>
          <div><%= order.shippingAddress.line1 %></div>
          <div><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> – <%= order.shippingAddress.pincode %></div>
          <div>📞 <%= order.shippingAddress.phone %></div>
        </div>
      </div>
      <div class="cart-summary-box">
        <h6 class="fw-bold mb-2">Payment</h6>
        <div class="summary-row"><span>Subtotal</span><span>₹<%= order.pricing.subtotal.toLocaleString() %></span></div>
        <div class="summary-row"><span>Shipping</span><span>₹<%= order.pricing.shipping %></span></div>
        <div class="summary-row"><span>GST</span><span>₹<%= order.pricing.gst.toLocaleString() %></span></div>
        <div class="summary-row total-row"><span>Total</span><span class="text-orange">₹<%= order.pricing.total.toLocaleString() %></span></div>
        <hr class="border-secondary">
        <div class="small text-muted">
          <div>Method: <%= order.payment.method %></div>
          <div>Status: <span class="<%= order.payment.status==='paid'?'text-success':'text-warning' %>"><%= order.payment.status %></span></div>
          <% if(order.payment.razorpayPaymentId) { %><div class="text-truncate">Txn: <%= order.payment.razorpayPaymentId %></div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>
