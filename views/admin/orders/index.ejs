<%- layout('layouts/boilerplate') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="section-title mb-0">Manage <span class="text-orange">Orders</span></h2>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
  </div>
  <!-- Status filter tabs -->
  <div class="d-flex gap-2 mb-3 flex-wrap">
    <% ['','placed','confirmed','processing','shipped','delivered','cancelled'].forEach(s => { %>
      <a href="/admin/orders<%= s ? '?status='+s : '' %>"
         class="btn btn-sm <%= (!status && !s) || status === s ? 'btn-orange' : 'btn-outline-secondary' %>">
        <%= s || 'All' %>
      </a>
    <% }) %>
  </div>
  <div class="admin-card">
    <div class="table-responsive">
      <table class="table rpt-table align-middle">
        <thead><tr><th>Order #</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td class="text-orange fw-bold">#<%= order.orderNumber %></td>
              <td><div class="fw-bold small"><%= (order.user && order.user.username) || 'N/A' %></div><div class="text-muted small"><%= (order.user && order.user.email) || '' %></div></td>
              <td><%= order.items.length %> items</td>
              <td class="fw-bold">₹<%= order.pricing.total.toLocaleString() %></td>
              <td><span class="badge <%= order.payment.status==='paid'?'bg-success':order.payment.status==='pending'?'bg-warning text-dark':'bg-danger' %>"><%= order.payment.status %></span></td>
              <td><span class="badge order-status-badge status-<%= order.status %>"><%= order.status %></span></td>
              <td class="text-muted small"><%= new Date(order.createdAt).toLocaleDateString('en-IN') %></td>
              <td><a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-orange">Manage</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
