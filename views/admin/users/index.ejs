<%- layout('layouts/boilerplate') %>
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">Manage <span class="text-orange">Users</span></h2>
    <a href="/admin" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
  </div>
  <div class="admin-card">
    <div class="table-responsive">
      <table class="table rpt-table align-middle">
        <thead><tr><th>#</th><th>Username</th><th>Email</th><th>Full Name</th><th>Phone</th><th>Joined</th></tr></thead>
        <tbody>
          <% users.forEach((user, i) => { %>
            <tr>
              <td class="text-muted small"><%= i + 1 %></td>
              <td class="fw-bold text-orange"><%= user.username %></td>
              <td><%= user.email %></td>
              <td><%= user.fullName || '—' %></td>
              <td><%= user.phone || '—' %></td>
              <td class="text-muted small"><%= new Date(user.createdAt).toLocaleDateString('en-IN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
