<%- layout('layouts/boilerplate') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb rpt-breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/products">Products</a></li>
      <li class="breadcrumb-item"><a href="/products?category=<%= product.category %>"><%= product.category %></a></li>
      <li class="breadcrumb-item active"><%= product.brand %></li>
    </ol>
  </nav>

  <div class="row g-5">
    <!-- GALLERY -->
    <div class="col-lg-5">
      <div class="detail-gallery">
        <img id="mainImg" src="<%= (product.images[0] && product.images[0].url) || product.primaryImage %>"
             alt="<%= product.name %>" class="detail-main-img img-fluid rounded">
        <% if (product.images.length > 1) { %>
          <div class="detail-thumbs mt-2 d-flex gap-2 flex-wrap">
            <% product.images.forEach((img, i) => { %>
              <img src="<%= img.thumbnail || img.url %>" alt="thumb"
                   class="detail-thumb <%= i===0?'active':'' %>"
                   onclick="changeImg(this, '<%= img.url %>')">
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DETAIL INFO -->
    <div class="col-lg-7">
      <div class="text-orange small fw-bold mb-1 font-mono"><%= product.brand.toUpperCase() %> · <%= product.category.toUpperCase() %></div>
      <h1 class="detail-title"><%= product.name %></h1>
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="stars fs-5"><%- '★'.repeat(Math.floor(product.avgRating)) %><%- '☆'.repeat(5-Math.floor(product.avgRating)) %></span>
        <strong><%= product.avgRating %></strong>
        <span class="text-muted small">(<%= product.reviews.length %> reviews)</span>
        <span class="<%= product.stock > 5 ? 'text-success' : product.stock > 0 ? 'text-warning' : 'text-danger' %> small fw-bold">
          ● <%= product.stock > 5 ? 'In Stock' : product.stock > 0 ? `Only ${product.stock} left` : 'Out of Stock' %>
        </span>
        <% if (product.badge) { %><span class="badge bg-orange"><%= product.badge %></span><% } %>
      </div>

      <!-- PRICE BOX -->
      <div class="price-box mb-3">
        <div class="d-flex align-items-center gap-3">
          <span class="detail-price">₹<%= product.price.toLocaleString() %></span>
          <span class="text-muted text-decoration-line-through">₹<%= product.mrp.toLocaleString() %></span>
          <span class="badge bg-success"><%= product.discount %>% off</span>
        </div>
        <small class="text-muted">Inclusive of all taxes · <% if(product.price >= 2000){%><span class="text-success">Free delivery</span><%}else{%>₹99 delivery<% } %></small>
      </div>

      <!-- QTY + ADD TO CART -->
      <div class="d-flex gap-3 align-items-center mb-4 flex-wrap">
        <div class="qty-ctrl">
          <button class="qty-btn" onclick="changeQty(-1)">−</button>
          <input type="number" id="qtyInput" value="1" min="1" max="<%= product.stock %>" class="qty-input">
          <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>
        <button class="btn btn-orange flex-fill" onclick="addToCartDetail('<%= product._id %>')" <%= product.stock < 1 ? 'disabled' : '' %>>
          <i class="bi bi-cart-plus me-1"></i> Add to Cart
        </button>
        <button class="btn btn-outline-orange" onclick="buyNow('<%= product._id %>')" <%= product.stock < 1 ? 'disabled' : '' %>>
          ⚡ Buy Now
        </button>
        <% if (currentUser) { %>
          <button class="btn btn-outline-secondary" onclick="toggleWishlist('<%= product._id %>', this)" title="Wishlist">
            <i class="bi bi-heart<%= (currentUser && currentUser.wishlist && currentUser.wishlist.includes(product._id.toString())) ? '-fill text-danger' : '' %>"></i>
          </button>
        <% } %>
      </div>

      <!-- KEY FEATURES -->
      <h6 class="fw-bold text-uppercase text-muted letter-spacing mb-2">Key Features</h6>
      <ul class="feature-list mb-4">
        <% product.features.forEach(f => { %><li><i class="bi bi-check2 text-orange me-2"></i><%= f %></li><% }) %>
      </ul>

      <!-- TABS -->
      <ul class="nav nav-tabs rpt-tabs mb-3">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-desc">Description</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-specs">Specifications</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-inbox">In the Box</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviews">Reviews (<%= product.reviews.length %>)</button></li>
      </ul>
      <div class="tab-content rpt-tab-content">
        <div class="tab-pane fade show active" id="tab-desc"><p><%= product.description %></p></div>
        <div class="tab-pane fade" id="tab-specs">
          <table class="table table-sm rpt-specs-table">
            <% product.specs.forEach(s => { %>
              <tr><td class="text-muted"><%= s.key %></td><td class="fw-medium"><%= s.value %></td></tr>
            <% }) %>
          </table>
        </div>
        <div class="tab-pane fade" id="tab-inbox">
          <ul class="list-unstyled"><% product.inBox.forEach(i => { %><li>📦 <%= i %></li><% }) %></ul>
        </div>
        <div class="tab-pane fade" id="tab-reviews">
          <% if (currentUser) { %>
            <form action="/products/<%= product._id %>/reviews" method="POST" class="mb-4 review-form">
              <h6 class="fw-bold">Write a Review</h6>
              <div class="star-rating mb-2">
                <% [5,4,3,2,1].forEach(n => { %>
                  <input type="radio" name="review[rating]" id="star<%= n %>" value="<%= n %>">
                  <label for="star<%= n %>">★</label>
                <% }) %>
              </div>
              <textarea class="form-control mb-2" name="review[comment]" rows="3" placeholder="Share your experience..." required></textarea>
              <button class="btn btn-orange btn-sm">Submit Review</button>
            </form>
          <% } else { %>
            <p class="text-muted"><a href="/login" class="text-orange">Login</a> to write a review.</p>
          <% } %>
          <% product.reviews.slice().reverse().forEach(r => { %>
            <div class="review-item mb-3 pb-3 border-bottom">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><%= r.name || 'Verified Buyer' %></strong>
                  <span class="stars ms-2"><%- '★'.repeat(r.rating) %><%- '☆'.repeat(5-r.rating) %></span>
                </div>
                <small class="text-muted"><%= new Date(r.date).toLocaleDateString('en-IN') %></small>
              </div>
              <p class="mb-1 mt-1 text-muted small"><%= r.comment %></p>
              <% if (currentUser && (currentUser._id.toString() === (r.user && r.user.toString()) || currentUser.isAdmin)) { %>
                <form action="/products/<%= product._id %>/reviews/<%= r._id %>?_method=DELETE" method="POST" class="d-inline">
                  <button class="btn btn-sm btn-link text-danger p-0">Delete</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- RELATED PRODUCTS -->
  <% if (related.length) { %>
    <div class="mt-5">
      <h3 class="section-title">Related <span class="text-orange">Products</span></h3>
      <div class="row g-3 mt-2">
        <% related.forEach(p => { %>
          <div class="col-sm-6 col-md-3">
            <div class="product-card">
              <a href="/products/<%= p._id %>"><img src="<%= p.primaryImage %>" class="product-img" alt="<%= p.name %>"></a>
              <div class="product-body">
                <div class="product-brand"><%= p.brand.toUpperCase() %></div>
                <a href="/products/<%= p._id %>" class="product-name"><%= p.name %></a>
                <div class="product-price-row mt-1">
                  <span class="product-price">₹<%= p.price.toLocaleString() %></span>
                  <span class="product-discount">-<%= p.discount %>%</span>
                </div>
              </div>
              <div class="product-footer">
                <button class="btn btn-orange btn-sm w-100" onclick="addToCart('<%= p._id %>')">Add to Cart</button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<script>
function changeImg(el, src) {
  document.getElementById('mainImg').src = src;
  document.querySelectorAll('.detail-thumb').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}
function changeQty(d) {
  const inp = document.getElementById('qtyInput');
  inp.value = Math.max(1, Math.min(parseInt(inp.value) + d, parseInt(inp.max)));
}
function addToCartDetail(id) {
  const qty = document.getElementById('qtyInput').value;
  addToCart(id, qty);
}
function buyNow(id) {
  const qty = document.getElementById('qtyInput').value;
  fetch('/cart/add', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ productId: id, qty })
  }).then(() => window.location.href = '/orders/checkout');
}
function toggleWishlist(id, btn) {
  fetch(`/products/${id}/wishlist`, { method: 'POST' })
    .then(r => r.json()).then(d => {
      const icon = btn.querySelector('i');
      icon.className = d.wishlisted ? 'bi bi-heart-fill text-danger' : 'bi bi-heart';
      showToast(d.message);
    });
}
</script>
